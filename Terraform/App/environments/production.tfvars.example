client_slug            = "example-client"
deployment_environment = "production"
aws_region             = "us-east-2"

lambda_handler                = "handlers/health.handler"
lambda_runtime                = "nodejs22.x"
lambda_zip_path               = "../../Backend/artifacts/production-portal-api.zip"
site_renderer_lambda_zip_path = "lambda_packages/site-renderer.zip"

frontend_site_origin = "https://replace-with-production-domain"

ses_from_email            = ""
ses_notification_to_email = ""
stripe_secret_key         = ""

auth0_domain   = "replace-with-production-auth0-domain"
auth0_audience = "https://replace-with-production-api-audience"

lambda_log_retention_days      = 30
api_gateway_log_retention_days = 30
cloudwatch_alarms_enabled      = false

# Optional paid alarms. Enabling these also requires the deploy role to have
# CloudWatch alarm permissions such as cloudwatch:PutMetricAlarm.
cloudwatch_lambda_error_alarm_targets    = []
cloudwatch_lambda_duration_alarm_targets = []
cloudwatch_api_alarm_types               = []

# Leave alarm actions empty until an SNS topic or incident-management action ARN
# is intentionally wired for the environment.
cloudwatch_alarm_actions                   = []
cloudwatch_alarm_ok_actions                = []
cloudwatch_alarm_insufficient_data_actions = []

# Optional WAF rate-limit Web ACL. The current flat-rate CloudFront Web ACL
# should be preserved unless a reviewed plan shows a safe attach/adoption path.
cloudfront_waf_rate_limiting_enabled    = false
cloudfront_waf_rate_limit_action        = "block"
cloudfront_waf_api_rate_limit           = 2000
cloudfront_waf_upload_presign_rate_limit = 300
cloudfront_waf_messages_rate_limit       = 600

cors_allowed_origins = [
  "https://replace-with-production-domain",
]

tags = {
  ManagedBy = "Terraform"
}
